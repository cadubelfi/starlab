{
  "name": "clinicorp-mcp",
  "version": "0.1.0",
  "description": "Conector MCP (Model Context Protocol) para a API da Clinicorp, com leitura por padrão e gravações liberadas uma a uma.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "clinicorp-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "typescript": "5.9.3"
  }
}
